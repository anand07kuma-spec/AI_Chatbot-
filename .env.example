# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Get a key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ----- Model router (all optional; sensible defaults if unset) -----
# Router mode for Auto: auto | fast | reasoning (default auto = classify per message)
# ASTRA_ROUTER_MODE=auto

# Fast model — short questions, simple chat (openai/gpt-oss-20b: ~1000 t/s)
# ASTRA_FAST_MODEL=openai/gpt-oss-20b

# Reasoning model — complex, code, long answers (openai/gpt-oss-120b: ~500 t/s)
# (legacy GROQ_MODEL is honoured as an alias for this)
# ASTRA_REASONING_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# Vision model — image understanding (max 3 images, 4MB each)
# ASTRA_VISION_MODEL=qwen/qwen3.8-27b

# Speech-to-text model
# ASTRA_STT_MODEL=whisper-large-v3-turbo

# Per-provider-call timeout in seconds (default 60)
# ASTRA_MODEL_TIMEOUT=60

# Streaming: max silent seconds between stream chunks (default 30)
# ASTRA_STREAM_IDLE_TIMEOUT=30

# Optional: requests per minute per IP for /api/* (0 disables rate limiting)
# RATE_LIMIT_PER_MINUTE=30

# Optional: comma-separated origins allowed to call the API cross-origin
# (leave empty to disable CORS entirely — same-origin only)
# ALLOWED_ORIGINS=https://your-frontend.example.com

# ----- Voice: TTS / STT -----
# TTS is Gemini TTS. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# TTS model (default works; speechConfig uses voiceConfig.prebuiltVoiceConfig)
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Shared default voice (Gemini prebuilt voice names: Kore, Puck, Charon, ...)
# GEMINI_TTS_VOICE=Kore

# Per-language voice overrides (Gemini voice names, not Edge voices)
# ASTRA_VOICE_EN=Kore
# ASTRA_VOICE_HI=Puck
# ASTRA_VOICE_UR=Charon

# Bounded in-memory TTS audio cache (entries, each ≤ ~800 chars of speech)
# ASTRA_TTS_CACHE_MAX=60

# Max recording seconds (client caps at 60s; server-side guard = 300s)
# STT_MAX_SECONDS=300

# ----- Live web search (optional; disabled if key unset) -----
# Get a key from https://app.tavily.com — free tier: 1,000 credits/month,
# no credit card required. PAYG after that: $0.008/credit.
# TAVILY_API_KEY=your_tavily_api_key_here

# Search provider: auto (default, picks Tavily if key set) | tavily | none
# ASTRA_SEARCH_PROVIDER=auto

# Max results per search (1-8, default 5)
# ASTRA_SEARCH_MAX_RESULTS=5

# Upstream search timeout in seconds (default 10)
# ASTRA_SEARCH_TIMEOUT=10

# Result cache TTL in seconds (default 900 = 15 min)
# ASTRA_SEARCH_CACHE_TTL=900

# Min seconds between upstream search calls (default 1.1)
# ASTRA_SEARCH_MIN_INTERVAL=1.1

# ----- Document intelligence & RAG (optional) -----
# OpenAI key enables real embeddings (text-embedding-3-small).
# Without it, a free local hash-embedding fallback is used automatically.
# OPENAI_API_KEY=your_openai_api_key_here

# Embeddings provider: auto (default: openai if key set, else hash) | openai | hash
# ASTRA_EMBEDDINGS_PROVIDER=auto

# OpenAI embedding model (only used when provider is openai)
# ASTRA_EMBED_MODEL=text-embedding-3-small

# Retrieval: top-k chunks and minimum cosine score (0-1)
# ASTRA_RETRIEVAL_TOP_K=4
# ASTRA_RETRIEVAL_MIN_SCORE=0.15

# Chunking (characters)
# ASTRA_CHUNK_SIZE=1000
# ASTRA_CHUNK_OVERLAP=200

# Document store caps
# ASTRA_MAX_DOCS_PER_CONVERSATION=5
# ASTRA_DOC_MAX_CHUNKS=400
# ASTRA_DOC_TTL_SECONDS=86400
# ASTRA_MAX_DOC_CONVERSATIONS=50

# PDF processing limits
# ASTRA_DOC_MAX_PAGES=50
# ASTRA_DOC_MAX_CHARS=500000
# ASTRA_DOC_PROCESS_TIMEOUT=25

# ----- Database: Supabase (guest mode — no login/signup) -----
# Server talks to Supabase via PostgREST (httpx). Tables: devices,
# conversations, messages, memories (created once via SQL Editor).
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key (server-side only; NEVER expose to the browser):
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Anon key (used for read probes / future client use):
SUPABASE_ANON_KEY=your_anon_key_here

# Force in-memory store (dev/tests). Default: supabase if URL+key set, else memory.
# ASTRA_STORE=memory

# Conversations are scoped per browser device via the X-Device-Id header
# (generated client-side, stored in localStorage "astra_device_id").

# ----- Code execution sandbox (Phase 7 — optional, disabled by default) -----
# Code execution is OFF unless you point ASTRA_SANDBOX_URL at a Piston-compatible
# sandbox API (https://github.com/engineer-man/piston — POST /api/v2/execute).
# The sandbox MUST run non-root, with network disabled, read-only base FS,
# and no host env/secrets mounted. Astra never exec()s code in-process.
# Without this, the coding assistant still works (explain/debug/refactor/tests)
# but the Run button stays hidden.
# ASTRA_SANDBOX_URL=https://your-piston-instance.example.com
# ASTRA_SANDBOX_KEY=optional_provider_api_key
# ASTRA_SANDBOX_TIME_MS=3000
# ASTRA_SANDBOX_TIMEOUT=15
